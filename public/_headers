# Cloudflare Workers static assets: header cho từng đường dẫn.
# CSS, JS, font, ảnh: cache 1 năm (immutable). Đổi file thì chạy tools/version-assets.ps1 để đổi ?v=.
# HTML: luôn kiểm tra bản mới.

/style.css
  Cache-Control: public, max-age=31536000, immutable

/script.js
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

/dich-vu/*
  Cache-Control: no-cache

# Bảo mật cơ bản cho mọi trang
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
