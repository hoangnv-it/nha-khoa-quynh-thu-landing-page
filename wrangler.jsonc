// Cấu hình Cloudflare Workers cho landing page Nha khoa Quỳnh Thư.
// - Chỉ phục vụ file tĩnh trong thư mục ./public (không có code Worker).
// - Đường dẫn không tồn tại sẽ trả về public/404.html.
// - Khi có tên miền riêng: thêm src/index.js (chuyển hướng 301 *.workers.dev -> tên miền)
//   giống dự án Diệu Hiền, rồi thêm "main" và "routes" vào file này.
{
  "name": "quynh-thu-landing-page",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
